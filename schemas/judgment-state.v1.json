{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoreview-ui.dev/schemas/judgment-state.v1.json",
  "title": "Autoreview UI durable judgment state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "sequence", "targets"],
  "properties": {
    "version": { "const": "judgment-state.v1" },
    "project": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 0 },
    "targets": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/target" }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "runId", "judgedAt", "disposition"],
      "properties": {
        "fingerprint": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
        "baseEvidenceDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "evidenceDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "rubricDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "promptDigests": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        },
        "runId": { "type": "string", "format": "uuid" },
        "judgedAt": { "type": "integer", "minimum": 1 },
        "disposition": { "enum": ["clean", "accepted", "rejected", "not-judged"] }
      }
    }
  }
}
