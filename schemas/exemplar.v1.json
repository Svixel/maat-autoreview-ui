{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoreview-ui.dev/schemas/exemplar.v1.json",
  "title": "Autoreview UI curated exemplar v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["screenshot", "rubricVersion", "curator", "expectedFindings", "severity"],
  "properties": {
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["available", "unavailable"] },
        "libraryPath": { "type": "string", "pattern": "^runs/[0-9a-f-]{36}/.+\\.png$" },
        "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "attachment": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "available" } } },
          "then": { "required": ["libraryPath", "sha256"] }
        },
        {
          "if": { "properties": { "status": { "const": "unavailable" } } },
          "then": { "required": ["reason"] }
        }
      ]
    },
    "rubricVersion": { "type": "string", "minLength": 1 },
    "curator": { "type": "string", "minLength": 1 },
    "expectedFindings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "severity": { "enum": ["P0", "P1", "P2", "P3"] }
  }
}
