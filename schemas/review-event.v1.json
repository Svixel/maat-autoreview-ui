{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoreview-ui.dev/schemas/review-event.v1.json",
  "title": "Autoreview UI review event log v1",
  "oneOf": [
    { "$ref": "#/$defs/header" },
    { "$ref": "#/$defs/initial" },
    { "$ref": "#/$defs/verification" },
    { "$ref": "#/$defs/disposition" },
    { "$ref": "#/$defs/seal" }
  ],
  "$defs": {
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "runId", "project", "configHash", "commitHash", "patchHash", "targets", "intentSource", "rubricVersion", "model", "createdAt"],
      "properties": {
        "kind": { "const": "record-header" },
        "version": { "const": 1 },
        "runId": { "type": "string", "format": "uuid" },
        "project": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_-]+$" },
        "configHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "commitHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{7,64}$" },
        "patchHash": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
        "targets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "targetShotHashes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        },
        "intentSource": { "type": "string", "minLength": 1 },
        "rubricVersion": { "type": "string", "minLength": 1 },
        "model": { "$ref": "#/$defs/model" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ruleId", "targetId", "assetId", "region", "evidence", "priority", "confidence", "initialVerdict", "scope"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "ruleId": { "type": "string", "minLength": 1 },
        "targetId": { "type": "string", "minLength": 1 },
        "assetId": { "type": "string", "minLength": 1 },
        "region": { "$ref": "https://autoreview-ui.dev/schemas/finding.v2.json#/properties/region" },
        "cropId": { "type": "string", "minLength": 1 },
        "cropDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "evidence": { "type": "string", "minLength": 1 },
        "priority": { "enum": ["P0", "P1", "P2", "P3"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "initialVerdict": { "enum": ["finding", "not-judged"] },
        "scope": { "enum": ["in-scope", "follow-up", "escalate"] }
      },
      "allOf": [
        {
          "if": { "required": ["cropDigest"] },
          "then": { "required": ["cropId"] }
        }
      ]
    },
    "initial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "eventId", "at", "finding"],
      "properties": {
        "kind": { "const": "initial" },
        "version": { "const": 1 },
        "eventId": { "type": "string", "format": "uuid" },
        "at": { "type": "string", "format": "date-time" },
        "finding": { "$ref": "#/$defs/candidate" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "eventId", "at", "findingId", "verifierVerdict", "evidence"],
      "properties": {
        "kind": { "const": "verification" },
        "version": { "const": 1 },
        "eventId": { "type": "string", "format": "uuid" },
        "at": { "type": "string", "format": "date-time" },
        "findingId": { "type": "string", "format": "uuid" },
        "verifierVerdict": { "enum": ["confirmed", "rejected", "not-judged"] },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "eventId", "at", "finding"],
      "properties": {
        "kind": { "const": "disposition" },
        "version": { "const": 1 },
        "eventId": { "type": "string", "format": "uuid" },
        "at": { "type": "string", "format": "date-time" },
        "finding": { "$ref": "https://autoreview-ui.dev/schemas/finding.v2.json" }
      }
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "eventId", "at", "findingCount"],
      "properties": {
        "kind": { "const": "seal" },
        "version": { "const": 1 },
        "eventId": { "type": "string", "format": "uuid" },
        "at": { "type": "string", "format": "date-time" },
        "findingCount": { "type": "integer", "minimum": 0 },
        "findingIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "format": "uuid" }
        }
      }
    }
  }
}
